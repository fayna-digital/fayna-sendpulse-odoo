<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="odoo_chatwoot_connector.SendpulseInfoPanel">
        <div class="o-sendpulse-InfoPanel d-flex flex-column h-100 border-start bg-view"
             style="width: 280px; min-width: 240px; overflow-y: auto;">

            <!-- Header -->
            <div class="d-flex align-items-center justify-content-between px-3 py-2 border-bottom bg-100">
                <span class="fw-semibold text-muted small text-uppercase">SendPulse</span>
                <div class="d-flex gap-1">
                    <button class="btn btn-sm btn-link p-0 text-muted"
                            title="Оновити профіль з API"
                            t-on-click="onRefreshClick">
                        <i class="fa fa-refresh"/>
                    </button>
                    <button class="btn btn-sm btn-link p-0 text-muted"
                            title="Відкрити картку розмови"
                            t-on-click="onOpenFormClick">
                        <i class="fa fa-external-link"/>
                    </button>
                </div>
            </div>

            <!-- Loading -->
            <t t-if="state.loading">
                <div class="d-flex justify-content-center align-items-center p-4">
                    <i class="fa fa-spinner fa-spin text-muted"/>
                </div>
            </t>

            <!-- Error -->
            <t t-elif="state.error">
                <div class="p-3 text-danger small">
                    <i class="fa fa-exclamation-circle"/> Помилка завантаження
                </div>
            </t>

            <!-- No connect found -->
            <t t-elif="!state.connect">
                <div class="p-3 text-muted small">
                    Дані контакту не знайдені
                </div>
            </t>

            <!-- Connect data -->
            <t t-else="">
                <!-- Avatar + Name -->
                <div class="d-flex flex-column align-items-center py-3 px-3 border-bottom">
                    <div class="mb-2" style="width: 64px; height: 64px;">
                        <t t-if="state.connect.avatar_url">
                            <img t-att-src="state.connect.avatar_url"
                                 class="rounded-circle w-100 h-100 object-fit-cover"
                                 t-att-alt="state.connect.name"/>
                        </t>
                        <t t-else="">
                            <div class="rounded-circle w-100 h-100 d-flex align-items-center justify-content-center bg-primary text-white fs-3">
                                <i class="fa fa-user"/>
                            </div>
                        </t>
                    </div>
                    <div class="fw-semibold text-center" t-esc="state.connect.name"/>
                    <div class="text-muted small">
                        <t t-esc="serviceIcon"/>
                        <t t-esc="' ' + state.connect.service_label"/>
                    </div>
                    <t t-if="state.connect.subscription_status">
                        <span t-att-class="statusBadgeClass" class="mt-1 small">
                            <t t-esc="state.connect.subscription_status_label"/>
                        </span>
                    </t>
                </div>

                <!-- Contact details -->
                <div class="px-3 py-2 border-bottom">
                    <div class="text-muted small text-uppercase fw-semibold mb-2">Контакт</div>

                    <t t-if="state.connect.social_username">
                        <div class="d-flex gap-2 mb-1 small">
                            <i class="fa fa-at text-muted mt-1" style="width:14px;"/>
                            <a t-if="state.connect.social_profile_url"
                               t-att-href="state.connect.social_profile_url"
                               target="_blank"
                               t-esc="state.connect.social_username"/>
                            <span t-else="" t-esc="state.connect.social_username"/>
                        </div>
                    </t>

                    <t t-if="state.connect.language_code">
                        <div class="d-flex gap-2 mb-1 small">
                            <i class="fa fa-language text-muted mt-1" style="width:14px;"/>
                            <span t-esc="state.connect.language_code"/>
                        </div>
                    </t>

                    <t t-if="state.connect.unidentified_email">
                        <div class="d-flex gap-2 mb-1 small">
                            <i class="fa fa-envelope text-muted mt-1" style="width:14px;"/>
                            <span t-esc="state.connect.unidentified_email"/>
                        </div>
                    </t>

                    <t t-if="state.connect.unidentified_phone">
                        <div class="d-flex gap-2 mb-1 small">
                            <i class="fa fa-phone text-muted mt-1" style="width:14px;"/>
                            <span t-esc="state.connect.unidentified_phone"/>
                        </div>
                    </t>
                </div>

                <!-- Bot variables -->
                <t t-if="state.connect.sp_child_name or state.connect.sp_booking_email">
                    <div class="px-3 py-2 border-bottom">
                        <div class="text-muted small text-uppercase fw-semibold mb-2">Дані бота</div>

                        <t t-if="state.connect.sp_child_name">
                            <div class="d-flex gap-2 mb-1 small">
                                <i class="fa fa-child text-muted mt-1" style="width:14px;"/>
                                <div>
                                    <div class="text-muted" style="font-size:10px;">Ім'я дитини</div>
                                    <span t-esc="state.connect.sp_child_name"/>
                                </div>
                            </div>
                        </t>

                        <t t-if="state.connect.sp_booking_email">
                            <div class="d-flex gap-2 mb-1 small">
                                <i class="fa fa-calendar text-muted mt-1" style="width:14px;"/>
                                <div>
                                    <div class="text-muted" style="font-size:10px;">Email бронювання</div>
                                    <span t-esc="state.connect.sp_booking_email"/>
                                </div>
                            </div>
                        </t>
                    </div>
                </t>

                <!-- Identified partner -->
                <t t-if="state.connect.partner">
                    <div class="px-3 py-2">
                        <div class="text-muted small text-uppercase fw-semibold mb-2">Клієнт Odoo</div>
                        <div class="d-flex gap-2 mb-1 small align-items-center">
                            <i t-attf-class="fa fa-user-circle mt-1 {{ state.connect.partner.active ? 'text-success' : 'text-danger' }}" style="width:14px;"/>
                            <span t-attf-class="fw-semibold {{ state.connect.partner.active ? 'text-success' : 'text-danger' }}" t-esc="state.connect.partner.name"/>
                        </div>
                        <t t-if="!state.connect.partner.active">
                            <div class="alert alert-danger py-2 px-2 mb-2 small" role="alert">
                                <div class="fw-semibold mb-1">
                                    <i class="fa fa-archive"/> Контакт в архіві
                                </div>
                                <div class="text-muted mb-2" style="font-size:11px;">
                                    Ймовірно потрапив автоматично через bulk-правило «порожні картки». Перевір і розархівуй, якщо клієнт активний.
                                </div>
                                <button class="btn btn-sm btn-danger w-100"
                                        t-on-click="onUnarchivePartner"
                                        t-att-disabled="state.unarchiveLoading">
                                    <t t-if="state.unarchiveLoading">
                                        <i class="fa fa-spinner fa-spin"/> Розархівую...
                                    </t>
                                    <t t-else="">
                                        <i class="fa fa-undo"/> Розархівувати
                                    </t>
                                </button>
                            </div>
                        </t>
                        <t t-if="state.connect.partner.email">
                            <div class="d-flex gap-2 mb-1 small">
                                <i class="fa fa-envelope text-muted mt-1" style="width:14px;"/>
                                <span t-esc="state.connect.partner.email"/>
                            </div>
                        </t>
                        <t t-if="state.connect.partner.phone">
                            <div class="d-flex gap-2 mb-1 small">
                                <i class="fa fa-phone text-muted mt-1" style="width:14px;"/>
                                <span t-esc="state.connect.partner.phone"/>
                            </div>
                        </t>
                    </div>
                </t>

                <!-- Not identified -->
                <t t-if="!state.connect.partner">
                    <div class="px-3 py-2">
                        <div class="text-warning small">
                            <i class="fa fa-exclamation-triangle"/> Клієнт не ідентифікований
                        </div>
                    </div>
                </t>

                <!-- F11: Переклад останнього вхідного -->
                <div class="px-3 py-2 border-top">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <div class="text-muted small text-uppercase fw-semibold">
                            🌐 Переклад
                        </div>
                        <div class="btn-group btn-group-sm" role="group">
                            <button class="btn btn-outline-secondary"
                                    t-on-click="() => this.onTranslate('pl')"
                                    t-att-disabled="state.translateLoading">
                                → PL
                            </button>
                            <button class="btn btn-outline-secondary"
                                    t-on-click="() => this.onTranslate('uk')"
                                    t-att-disabled="state.translateLoading">
                                → UK
                            </button>
                        </div>
                    </div>
                    <t t-if="state.translateLoading">
                        <div class="text-muted small text-center py-2">
                            <i class="fa fa-spinner fa-spin"/> Перекладаю...
                        </div>
                    </t>
                    <t t-if="state.translateError">
                        <div class="text-muted small">
                            <t t-esc="state.translateError"/>
                        </div>
                    </t>
                    <t t-if="state.translatedText">
                        <div class="text-muted small mb-1" style="font-size: 10px;">
                            З <t t-esc="state.translateSourceLang || '?'"/>
                            · клік — копіювати
                        </div>
                        <div class="border rounded p-2 small"
                             style="cursor: pointer; background: #f8f9fa; white-space: pre-wrap;"
                             t-on-click="onCopyTranslation">
                            <div class="d-flex justify-content-between gap-2">
                                <div style="flex: 1;" t-esc="state.translatedText"/>
                                <t t-if="state.translateCopied">
                                    <span class="badge text-bg-success flex-shrink-0">
                                        <i class="fa fa-check"/>
                                    </span>
                                </t>
                                <t t-else="">
                                    <i class="fa fa-copy text-muted flex-shrink-0 mt-1"/>
                                </t>
                            </div>
                        </div>
                    </t>
                </div>

                <!-- F13: Lead magnet — PDF + SMS-купон -->
                <t t-if="state.connect.lead_magnet_enabled">
                    <div class="px-3 py-2 border-top">
                        <div class="text-muted small text-uppercase fw-semibold mb-2">
                            🎁 Маркетинг (F13)
                        </div>

                        <!-- PDF-каталог -->
                        <t t-if="state.connect.pdf_sent_at">
                            <div class="alert alert-success py-2 px-2 small mb-2" role="alert">
                                <i class="fa fa-check-circle"/>
                                PDF надіслано на
                                <strong><t t-esc="state.connect.pdf_sent_to_email"/></strong>
                                <div class="text-muted" style="font-size: 10px;">
                                    <t t-esc="state.connect.pdf_sent_at"/>
                                </div>
                            </div>
                        </t>
                        <t t-else="">
                            <div class="mb-2">
                                <div class="small fw-semibold mb-1">📄 PDF-каталог</div>
                                <div class="input-group input-group-sm">
                                    <input type="email" class="form-control"
                                           placeholder="email@example.com"
                                           t-model="state.pdfEmail"
                                           t-att-disabled="state.pdfLoading"/>
                                    <button class="btn btn-outline-primary"
                                            t-on-click="onSendPdf"
                                            t-att-disabled="state.pdfLoading or !state.pdfEmail">
                                        <t t-if="state.pdfLoading">
                                            <i class="fa fa-spinner fa-spin"/>
                                        </t>
                                        <t t-else="">Надіслати</t>
                                    </button>
                                </div>
                                <t t-if="state.pdfError">
                                    <div class="text-danger small mt-1"><t t-esc="state.pdfError"/></div>
                                </t>
                            </div>
                        </t>

                        <!-- SMS-купон -->
                        <t t-if="state.connect.coupon_code">
                            <div class="alert alert-success py-2 px-2 small" role="alert">
                                <i class="fa fa-check-circle"/>
                                SMS-купон надіслано на
                                <strong><t t-esc="state.connect.coupon_sent_to_phone"/></strong>
                                <div class="text-muted" style="font-size: 10px;">
                                    Код: <code><t t-esc="state.connect.coupon_code"/></code>
                                    · <t t-esc="state.connect.coupon_sent_at"/>
                                </div>
                            </div>
                        </t>
                        <t t-else="">
                            <div>
                                <div class="small fw-semibold mb-1">📱 SMS-купон 5%</div>
                                <div class="input-group input-group-sm">
                                    <input type="tel" class="form-control"
                                           placeholder="+48 600 123 456"
                                           t-model="state.smsPhone"
                                           t-att-disabled="state.smsLoading"/>
                                    <button class="btn btn-outline-primary"
                                            t-on-click="onSendSmsCoupon"
                                            t-att-disabled="state.smsLoading or !state.smsPhone">
                                        <t t-if="state.smsLoading">
                                            <i class="fa fa-spinner fa-spin"/>
                                        </t>
                                        <t t-else="">Надіслати</t>
                                    </button>
                                </div>
                                <t t-if="state.smsError">
                                    <div class="text-danger small mt-1"><t t-esc="state.smsError"/></div>
                                </t>
                                <t t-if="state.smsSuccess">
                                    <div class="text-success small mt-1">
                                        Код <code><t t-esc="state.smsSuccess.code"/></code> надіслано. Залишилось <t t-esc="state.smsSuccess.remaining"/> купонів.
                                    </div>
                                </t>
                            </div>
                        </t>
                    </div>
                </t>

                <!-- F10: AI Suggested Replies -->
                <div class="px-3 py-2 border-top">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <div class="text-muted small text-uppercase fw-semibold">
                            🤖 AI-драфти відповіді
                        </div>
                        <button class="btn btn-sm btn-outline-primary"
                                t-on-click="onSuggestReply"
                                t-att-disabled="state.suggestLoading">
                            <t t-if="state.suggestLoading">
                                <i class="fa fa-spinner fa-spin"/>
                            </t>
                            <t t-else="">
                                <i class="fa fa-magic"/> Згенерувати
                            </t>
                        </button>
                    </div>

                    <t t-if="state.suggestError">
                        <div class="text-muted small">
                            Немає варіантів. Можливо, LLM-класифікатор вимкнено
                            у Settings або Anthropic API key не налаштовано.
                        </div>
                    </t>

                    <t t-if="state.suggestions.length > 0">
                        <div class="text-muted small mb-2" style="font-size: 11px;">
                            Клікніть варіант — скопіюється у буфер. Вставте у композер Cmd+V (Ctrl+V).
                        </div>
                        <t t-foreach="state.suggestions" t-as="suggestion" t-key="suggestion_index">
                            <div class="border rounded p-2 mb-2 small"
                                 style="cursor: pointer; background: #f8f9fa;"
                                 t-on-click="() => this.onCopySuggestion(suggestion_index)">
                                <div class="d-flex justify-content-between align-items-start gap-2">
                                    <div style="flex: 1; white-space: pre-wrap;" t-esc="suggestion"/>
                                    <t t-if="state.copiedIdx === suggestion_index">
                                        <span class="badge text-bg-success flex-shrink-0">
                                            <i class="fa fa-check"/> скопійовано
                                        </span>
                                    </t>
                                    <t t-else="">
                                        <i class="fa fa-copy text-muted flex-shrink-0 mt-1"/>
                                    </t>
                                </div>
                            </div>
                        </t>
                    </t>
                </div>
            </t>
        </div>
    </t>

</templates>
