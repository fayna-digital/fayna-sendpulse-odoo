<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- List View -->
    <record id="view_channel_backend_list" model="ir.ui.view">
        <field name="name">channel.backend.list</field>
        <field name="model">channel.backend</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" string="Назва" />
                <field name="service" string="Канал" />
                <field name="provider" string="Провайдер" />
                <field name="transport_priority" string="Пріоритет" />
                <field name="active" string="Увімкнено" />
                <field name="last_healthcheck_ok" string="Healthcheck OK" />
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_channel_backend_form" model="ir.ui.view">
        <field name="name">channel.backend.form</field>
        <field name="model">channel.backend</field>
        <field name="arch" type="xml">
            <form string="Канал власного транспорту">
                <header>
                    <button name="register_telegram_webhook" type="object"
                        string="Реєструвати Telegram webhook"
                        invisible="service != 'telegram'" />
                    <button name="action_switch_all_to_own" type="object"
                        string="M4: Перемкнути всі на own"
                        confirm="Перемкнути ВСІ канали на власний транспорт і вимкнути SendPulse?" />
                    <field name="active" widget="boolean_toggle" />
                </header>
                <sheet>
                    <group>
                        <group string="Основна інформація">
                            <field name="name" />
                            <field name="service" />
                            <field name="provider" />
                            <field name="transport_priority" />
                        </group>
                        <group string="Telegram">
                            <field name="bot_token" password="1" invisible="service != 'telegram'" />
                            <field name="bot_id" invisible="service != 'telegram'" />
                            <field name="heal_url" readonly="1" widget="url" />
                        </group>
                    </group>
                    <group>
                        <group string="Оператори">
                            <field name="user_ids" widget="many2many_tags"
                                domain="[('share', '=', False), ('active', '=', True)]" />
                        </group>
                        <group string="Обмеження">
                            <field name="partner_domain" />
                        </group>
                    </group>
                    <group string="Метрики">
                        <group>
                            <field name="last_healthcheck_at" />
                            <field name="last_healthcheck_ok" />
                        </group>
                        <group>
                            <field name="last_error" readonly="1" />
                        </group>
                    </group>
                    <group string="Credentials (JSON)" invisible="not credentials">
                        <field name="credentials" nolabel="1" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_channel_backend_search" model="ir.ui.view">
        <field name="name">channel.backend.search</field>
        <field name="model">channel.backend</field>
        <field name="arch" type="xml">
            <search string="Пошук каналів">
                <field name="name" />
                <field name="service" />
                <field name="provider" />
                <separator />
                <filter name="filter_active" string="Активні" domain="[('active','=',True)]" />
                <filter name="filter_telegram" string="Telegram"
                    domain="[('service','=','telegram')]" />
                <group string="Згрупувати за">
                    <filter name="group_service" string="Канал" context="{'group_by':'service'}" />
                    <filter name="group_provider" string="Провайдер"
                        context="{'group_by':'provider'}" />
                </group>
            </search>
        </field>
    </record>

    <!-- Actions -->
    <record id="action_channel_backend" model="ir.actions.act_window">
        <field name="name">Канали власного транспорту</field>
        <field name="res_model">channel.backend</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_channel_backend_search" />
        <field name="context">{}</field>
    </record>

    <!-- Menu -->
    <menuitem id="menu_channel_bridge_root"
        name="Channel Bridge"
        sequence="95"
        groups="fayna_channel_bridge.group_channel_bridge_officer" />

    <menuitem id="menu_channel_bridge_backends"
        name="Канали"
        parent="menu_channel_bridge_root"
        action="action_channel_backend"
        sequence="10" />

</odoo>
