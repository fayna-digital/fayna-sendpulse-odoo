<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Екран «Підключити канали» — OWL-SPA (ТЗ_OMNI_DASHBOARD_OWL.md, Фаза 1).
         Штатні вигляди (kanban/form) для цього екрана НЕ використовуються:
         інтерфейс — client action на OWL, Master-Detail, за патерном Discuss.
         Дані — з channel.provider через один RPC get_dashboard_data(). -->

    <!-- Client action: відкриває OWL-компонент ChannelDashboard. -->
    <record id="action_channel_provider" model="ir.actions.client">
        <field name="name">Connect channels</field>
        <field name="tag">fayna_channel_bridge.channel_dashboard</field>
    </record>

    <menuitem id="menu_channel_bridge_providers"
        name="Connect channels"
        parent="menu_channel_bridge_root"
        action="action_channel_provider"
        sequence="5"
        groups="fayna_channel_bridge.group_channel_bridge_admin" />
</odoo>
