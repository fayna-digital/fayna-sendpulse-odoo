<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Галерея «Підключити канали» (В-3). Блокери видимі на картці ДО
         натискання (UX-15); жодного токена/секрету/URL вебхука (UX-14). -->

    <record id="view_channel_provider_kanban" model="ir.ui.view">
        <field name="name">channel.provider.kanban</field>
        <field name="model">channel.provider</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" create="false">
                <field name="name" />
                <field name="is_connected" />
                <field name="status_label" />
                <field name="connect_method" />
                <field name="description" />
                <field name="cost_warning" />
                <field name="side_effect_warning" />
                <field name="region_blocklist" />
                <field name="consent_required" />
                <field name="has_unconfirmed_preconditions" />
                <field name="blocking_reason" />
                <templates>
                    <t t-name="kanban-box">
                        <!-- d-flex flex-column h-100: картка — flex-колонка, нижній
                             блок притиснуто до низу (Е-3), висоти карток у ряду
                             вирівнюються штатно (Е-4). -->
                        <div class="oe_kanban_global_click d-flex flex-column h-100">
                            <div class="d-flex align-items-start mb-1">
                                <img
                                    t-att-src="'/fayna_channel_bridge/static/img/channel_placeholder.svg'"
                                    class="me-2"
                                    style="width: 40px; height: 40px; flex: 0 0 auto;"
                                    alt="Channel icon" />
                                <div class="o_kanban_record_title">
                                    <field name="name" />
                                    <span t-if="record.is_connected.raw_value"
                                        class="badge text-bg-success ms-1">Connected</span>
                                    <span t-else=""
                                        class="badge text-bg-secondary ms-1">Not connected</span>
                                </div>
                            </div>
                            <div t-if="record.description.raw_value"
                                class="text-muted mb-1 o_kanban_description">
                                <field name="description" />
                            </div>
                            <div t-if="record.cost_warning.raw_value"
                                class="text-danger mb-1">
                                <i class="fa fa-exclamation-triangle me-1"
                                    title="Cost warning" />
                                <field name="cost_warning" />
                            </div>
                            <div t-if="record.side_effect_warning.raw_value"
                                class="text-warning mb-1">
                                <i class="fa fa-exclamation-circle me-1"
                                    title="Side effect" />
                                <field name="side_effect_warning" />
                            </div>
                            <div t-if="record.region_blocklist.raw_value"
                                class="text-danger mb-1">
                                <i class="fa fa-ban me-1" /> Unavailable: <field
                                    name="region_blocklist" />
                            </div>
                            <div t-if="record.consent_required.raw_value"
                                class="text-info mb-1">
                                <i class="fa fa-check-square-o me-1" /> User consent required </div>
                            <!-- UX-16 (Е-2): причина блокування видима на картці. -->
                            <div t-if="record.has_unconfirmed_preconditions.raw_value"
                                class="text-danger mb-1">
                                <i class="fa fa-lock me-1"
                                    title="Blocked" />
                                <field
                                    name="blocking_reason" />
                            </div>
                            <div class="o_kanban_record_bottom mt-auto pt-2">
                                <button t-if="record.is_connected.raw_value"
                                    name="action_open_backend"
                                    type="object"
                                    class="btn btn-primary btn-sm"
                                    string="Open channel" />
                                <!-- UX-аудит (Ш6/Т8): можливість відключити канал
                                     прямо з галереї. -->
                                <button t-if="record.is_connected.raw_value"
                                    name="action_disconnect"
                                    type="object"
                                    class="btn btn-outline-danger btn-sm ms-1"
                                    string="Disconnect"
                                    confirm="Disconnect this channel? Messages will stop flowing." />
                                <button t-elif="record.has_unconfirmed_preconditions.raw_value"
                                    name="action_connect"
                                    type="object"
                                    class="btn btn-secondary btn-sm"
                                    string="Connect"
                                    disabled="disabled" />
                                <!-- UX-аудит (Н5): якщо є попередження (платність,
                                     втрата контролю) — вимагаємо підтвердження перед
                                     підключенням. -->
                                <button
                                    t-elif="record.cost_warning.raw_value or record.side_effect_warning.raw_value"
                                    name="action_connect"
                                    type="object"
                                    class="btn btn-primary btn-sm"
                                    string="Connect"
                                    confirm="This channel has warnings (cost / side effects). Connect anyway?" />
                                <button t-else=""
                                    name="action_connect"
                                    type="object"
                                    class="btn btn-primary btn-sm"
                                    string="Connect" />
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Form: ліворуч опис, праворуч рівно одна головна дія (UX-10, T-115). -->
    <record id="view_channel_provider_form" model="ir.ui.view">
        <field name="name">channel.provider.form</field>
        <field name="model">channel.provider</field>
        <field name="arch" type="xml">
            <form string="Channel">
                <header>
                    <!-- UX-аудит (Н5): якщо є попередження — вимагаємо підтвердження
                         перед підключенням. -->
                    <button name="action_connect"
                        type="object"
                        string="Connect"
                        class="btn-primary"
                        invisible="has_unconfirmed_preconditions"
                        confirm="cost_warning or side_effect_warning ? 'This channel has warnings (cost / side effects). Connect anyway?' : ''" />
                </header>
                <sheet>
                    <field name="is_connected" invisible="1" />
                    <field name="has_unconfirmed_preconditions" invisible="1" />
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1" />
                        </h1>
                        <span invisible="not is_connected"
                            class="badge text-bg-success">Connected</span>
                        <span invisible="is_connected"
                            class="badge text-bg-secondary">Not connected</span>
                    </div>
                    <!-- UX-16 (Е-2): причина блокування видима, кнопка прихована. -->
                    <div class="alert alert-danger"
                        invisible="not has_unconfirmed_preconditions"
                        role="alert">
                        <i class="fa fa-lock me-1"
                            title="Blocked" />
                        <field name="blocking_reason" />
                    </div>
                    <group>
                        <group>
                            <field name="service" readonly="1" />
                            <field name="connect_method" readonly="1" />
                            <field name="sequence" />
                            <field name="active" />
                            <field name="help_url"
                                widget="url"
                                string="How to get an access key?"
                                invisible="connect_method != 'token'" />
                        </group>
                        <group>
                            <field name="description" readonly="1" />
                            <field name="token_placeholder" readonly="1" />
                            <field name="region_blocklist" readonly="1" />
                            <field name="consent_required" readonly="1" />
                            <field name="cost_warning" readonly="1" />
                            <field name="side_effect_warning" readonly="1" />
                            <field name="precondition_ids" readonly="1" />
                        </group>
                    </group>
                    <!-- Підтвердження передумов (Е-2): робиться у формі каналу,
                         не на картці галереї. -->
                    <group string="Precondition confirmation"
                        invisible="not (region_blocklist or consent_required)">
                        <group>
                            <field name="region_confirmed"
                                invisible="not region_blocklist" />
                            <field name="consent_confirmed"
                                invisible="not consent_required" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action + меню «Підключити канали» (доступ Administrator). -->
    <record id="action_channel_provider" model="ir.actions.act_window">
        <field name="name">Connect channels</field>
        <field name="res_model">channel.provider</field>
        <field name="view_mode">kanban,form</field>
        <field name="view_id" ref="view_channel_provider_kanban" />
    </record>

    <menuitem id="menu_channel_bridge_providers"
        name="Connect channels"
        parent="menu_channel_bridge_root"
        action="action_channel_provider"
        sequence="5"
        groups="fayna_channel_bridge.group_channel_bridge_admin" />
</odoo>
