<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_sendpulse_facebook_page_tree" model="ir.ui.view">
        <field name="name">sendpulse.facebook.page.tree</field>
        <field name="model">sendpulse.facebook.page</field>
        <field name="arch" type="xml">
            <tree string="Facebook Pages">
                <field name="name"/>
                <field name="page_id"/>
                <field name="ig_business_id"/>
                <field name="category"/>
                <field name="token_status"/>
                <field name="last_checked_at"/>
                <field name="is_default" widget="boolean_toggle"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <record id="view_sendpulse_facebook_page_form" model="ir.ui.view">
        <field name="name">sendpulse.facebook.page.form</field>
        <field name="model">sendpulse.facebook.page</field>
        <field name="arch" type="xml">
            <form string="Facebook Page">
                <header>
                    <button name="action_verify_token" type="object" string="Перевірити токен" class="oe_highlight"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="За замовчуванням" invisible="not is_default"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Назва Page"/></h1>
                    </div>
                    <group>
                        <group string="Ідентифікатори">
                            <field name="page_id" placeholder="106771868966309"/>
                            <field name="ig_business_id" placeholder="17841457668400063"/>
                            <field name="category"/>
                        </group>
                        <group string="Стан">
                            <field name="active"/>
                            <field name="is_default"/>
                            <field name="token_status" readonly="1"/>
                            <field name="last_checked_at" readonly="1"/>
                        </group>
                    </group>
                    <group string="Автентифікація">
                        <field name="access_token" password="True" placeholder="EAAjIM..."/>
                    </group>
                    <group string="Шаблони (overrides)">
                        <field name="landing_url" placeholder="https://lato2026.campscout.eu"/>
                        <field name="tg_url" placeholder="https://t.me/campscouting"/>
                        <field name="yt_url"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_sendpulse_facebook_page" model="ir.actions.act_window">
        <field name="name">Facebook Pages</field>
        <field name="res_model">sendpulse.facebook.page</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>
