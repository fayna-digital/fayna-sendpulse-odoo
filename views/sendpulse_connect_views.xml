<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Form View для sendpulse.message (без raw_json) -->
    <record id="view_sendpulse_message_form" model="ir.ui.view">
        <field name="name">sendpulse.message.form</field>
        <field name="model">sendpulse.message</field>
        <field name="arch" type="xml">
            <form string="Повідомлення" create="false" edit="false">
                <sheet>
                    <group>
                        <group string="Основна інформація">
                            <field name="date" string="Дата"/>
                            <field name="direction" string="Напрямок"/>
                            <field name="message_type" string="Тип"/>
                            <field name="connect_id" string="Розмова"/>
                        </group>
                        <group string="Контакт">
                            <field name="sendpulse_contact_id" string="SendPulse Contact ID"/>
                        </group>
                    </group>
                    <group string="Повідомлення">
                        <field name="text_message" string="" nolabel="1"/>
                    </group>
                    <group string="Вкладення" invisible="not attachment_url">
                        <field name="attachment_url" string="" nolabel="1" widget="url"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- List View -->
    <record id="view_sendpulse_connect_list" model="ir.ui.view">
        <field name="name">sendpulse.connect.list</field>
        <field name="model">sendpulse.connect</field>
        <field name="arch" type="xml">
            <tree string="Розмови SendPulse"
                  decoration-danger="stage == 'new'"
                  decoration-warning="stage == 'new_message'"
                  decoration-muted="stage == 'close'"
                  create="false">
                <field name="name" string="Контакт"/>
                <field name="service" string="Канал"/>
                <field name="partner_id" string="Клієнт"/>
                <field name="social_username" string="Username"/>
                <field name="last_message_preview" string="Останнє повідомлення"/>
                <field name="last_message_date" string="Дата"/>
                <field name="stage" string="Статус"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_sendpulse_connect_form" model="ir.ui.view">
        <field name="name">sendpulse.connect.form</field>
        <field name="model">sendpulse.connect</field>
        <field name="arch" type="xml">
            <form string="Розмова SendPulse">
                <header>
                    <button name="action_open_discuss" type="object"
                            string="Відкрити чат" class="btn-primary"
                            invisible="stage == 'close'"/>
                    <button name="action_identify_partner"
                            string="Ідентифікувати клієнта"
                            type="object"
                            class="btn-warning"
                            invisible="partner_id != False or stage == 'close'"/>
                    <button name="action_fetch_contact_info" type="object"
                            string="Оновити профіль"
                            invisible="not sendpulse_contact_id"/>
                    <button name="action_close" type="object"
                            string="Закрити розмову"
                            invisible="stage == 'close'"/>
                    <button name="action_reopen" type="object"
                            string="Відновити"
                            invisible="stage != 'close'"/>
                    <field name="stage" widget="statusbar"
                           statusbar_visible="new,in_progress,new_message,close"/>
                </header>
                <sheet>
                    <group>
                        <group string="Клієнт">
                            <field name="partner_id" placeholder="Не ідентифікований"/>
                            <field name="unidentified_email" string="Email (з SendPulse)"
                                   invisible="partner_id != False"/>
                            <field name="unidentified_phone" string="Телефон"
                                   invisible="partner_id != False"/>
                        </group>
                        <group string="Канал">
                            <field name="service"/>
                            <field name="social_username" string="Username"/>
                            <field name="social_profile_url" string="URL профілю" widget="url"/>
                            <field name="bot_name" string="Бот"/>
                        </group>
                    </group>
                    <group>
                        <group string="Дані бота">
                            <field name="sp_child_name" string="Ім'я дитини"/>
                            <field name="sp_booking_email" string="Email бронювання"/>
                        </group>
                        <group string="Профіль SendPulse">
                            <field name="avatar_url" string="Аватар (URL)" widget="url"
                                   invisible="not avatar_url"/>
                            <field name="language_code" string="Мова"/>
                            <field name="subscription_status" string="Статус підписки"/>
                        </group>
                    </group>
                    <group>
                        <group string="Оператори">
                            <field name="user_ids" widget="many2many_tags" domain="[('share', '=', False), ('active', '=', True)]"/>
                        </group>
                        <group string="SendPulse">
                            <field name="sendpulse_contact_id" string="Contact ID"/>
                            <field name="last_message_date" string="Останнє повідомлення"/>
                            <field name="channel_id" string="Discuss Канал"/>
                        </group>
                    </group>
                    <!-- Секція коментаря — видима тільки якщо розмова ініційована з коментаря -->
                    <group string="💬 Коментар (Facebook / Instagram)" invisible="not sp_is_comment">
                        <group>
                            <field name="sp_is_comment" string="Ініційовано з коментаря" readonly="1"/>
                            <field name="sp_comment_text" string="Текст коментаря" readonly="1"/>
                            <field name="sp_post_url" string="URL допису" widget="url" readonly="1"/>
                        </group>
                        <group>
                            <field name="sp_replied_public" string="Публічна відповідь надіслана" readonly="1"/>
                            <field name="sp_replied_private" string="Приватне повідомлення надіслано" readonly="1"/>
                            <field name="sp_comment_id" string="Comment ID" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Повідомлення" name="messages">
                            <field name="message_ids" readonly="1">
                                <tree create="false">
                                    <field name="date" string="Дата"/>
                                    <field name="direction" string="Напрямок"/>
                                    <field name="text_message" string="Текст"/>
                                    <field name="attachment_url" string="Вкладення"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_sendpulse_connect_search" model="ir.ui.view">
        <field name="name">sendpulse.connect.search</field>
        <field name="model">sendpulse.connect</field>
        <field name="arch" type="xml">
            <search string="Пошук розмов">
                <field name="name" string="Ім'я контакту"/>
                <field name="partner_id" string="Клієнт"/>
                <field name="social_username" string="Username"/>
                <separator/>
                <filter name="filter_new" string="Нові" domain="[('stage','=','new')]"/>
                <filter name="filter_new_msg" string="Нові повідомлення" domain="[('stage','=','new_message')]"/>
                <filter name="filter_in_progress" string="В роботі" domain="[('stage','=','in_progress')]"/>
                <filter name="filter_unidentified" string="Не ідентифіковані" domain="[('partner_id','=',False)]"/>
                <filter name="filter_close" string="Закриті" domain="[('stage','=','close')]"/>
                <separator/>
                <filter name="filter_telegram" string="Telegram" domain="[('service','=','telegram')]"/>
                <filter name="filter_instagram" string="Instagram" domain="[('service','=','instagram')]"/>
                <filter name="filter_facebook" string="Facebook" domain="[('service','=','facebook')]"/>
                <separator/>
                <group string="Згрупувати за">
                    <filter name="group_service" string="Канал" context="{'group_by':'service'}"/>
                    <filter name="group_stage" string="Статус" context="{'group_by':'stage'}"/>
                    <filter name="group_partner" string="Клієнт" context="{'group_by':'partner_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Settings Form -->
    <record id="view_sendpulse_config_form" model="ir.ui.view">
        <field name="name">sendpulse.config.form</field>
        <field name="model">res.config.settings</field>
        <field name="arch" type="xml">
            <form string="Налаштування SendPulse Odo">
                <header>
                    <button string="Зберегти" type="object" name="execute" class="btn-primary"/>
                    <button string="Скасувати" special="cancel"/>
                </header>
                <sheet>
                    <h2>SendPulse API</h2>
                    <group>
                        <group string="OAuth Авторизація">
                            <field name="sendpulse_client_id" placeholder="Client ID з SendPulse"/>
                            <field name="sendpulse_client_secret" password="True" placeholder="Client Secret"/>
                            <field name="sendpulse_secret_is_set" invisible="1"/>
                            <div colspan="2">
                                <small class="text-success" invisible="not sendpulse_secret_is_set">✓ Secret збережено</small>
                                <small class="text-warning" invisible="sendpulse_secret_is_set">⚠ Secret не налаштовано</small>
                            </div>
                            <field name="sendpulse_webhook_token" placeholder="Секретний токен"/>
                        </group>
                        <group string="Webhook URL">
                            <field name="sendpulse_webhook_url" readonly="1"/>
                        </group>
                    </group>
                    <h2>Відповіді на коментарі FB / Instagram</h2>
                    <group>
                        <group string="Увімкнення">
                            <field name="sp_comment_autoreply_enabled" string="Автовідповідь на коментарі FB/IG"/>
                            <field name="sp_comment_public_enabled" string="Публічна відповідь під коментарем"/>
                            <field name="sp_comment_private_enabled" string="Приватне повідомлення (перший раз)"/>
                        </group>
                        <group string="Facebook Page Access Token">
                            <field name="fb_page_access_token" password="True"
                                   placeholder="Вставте Page Access Token"
                                   string="Page Access Token"/>
                            <field name="fb_page_token_is_set" invisible="1"/>
                            <div colspan="2">
                                <small class="text-success" invisible="not fb_page_token_is_set">✓ Token збережено</small>
                                <small class="text-warning" invisible="fb_page_token_is_set">⚠ Token не налаштовано</small>
                            </div>
                        </group>
                    </group>
                    <group>
                        <group string="URL-и для шаблонів">
                            <field name="sp_comment_landing_url" string="Лендінг URL"/>
                            <field name="sp_comment_tg_url" string="Telegram URL"/>
                            <field name="sp_comment_yt_url" string="YouTube URL"/>
                        </group>
                        <group string="Приватне повідомлення">
                            <field name="sp_comment_private_text" string="Текст (порожньо = дефолт)" nolabel="1" class="o_field_char"/>
                        </group>
                    </group>
                    <group>
                        <group string="Instagram">
                            <field name="ig_user_id" placeholder="17841457668400063"/>
                            <field name="ig_user_id_is_set" invisible="1"/>
                            <div colspan="2">
                                <small class="text-success" invisible="not ig_user_id_is_set">✓ IG ID збережено</small>
                                <small class="text-warning" invisible="ig_user_id_is_set">⚠ Потрібен для private_reply на IG-коментарі</small>
                            </div>
                        </group>
                        <group string="Facebook App (для /debug_token)">
                            <field name="fb_app_id" placeholder="2471909913241204"/>
                            <field name="fb_app_secret" password="True" placeholder="App Secret"/>
                            <field name="fb_app_secret_is_set" invisible="1"/>
                            <div colspan="2">
                                <small class="text-success" invisible="not fb_app_secret_is_set">✓ Secret збережено</small>
                                <small class="text-muted" invisible="fb_app_secret_is_set">Потрібно для відстеження терміну дії токена</small>
                            </div>
                            <field name="fb_token_status" readonly="1"/>
                            <field name="fb_token_last_check" readonly="1"/>
                        </group>
                    </group>

                    <h2>Multi-page Facebook/Instagram</h2>
                    <group>
                        <group string="Синхронізація з Meta">
                            <field name="fb_pages_count" readonly="1"/>
                            <field name="fb_sync_user_token" password="True"
                                   placeholder="EAAjIM... (User Access Token)"/>
                            <button name="action_sync_fb_pages" type="object"
                                    string="Синхронізувати з Meta /me/accounts"
                                    class="btn-primary" icon="fa-refresh"
                                    invisible="not fb_sync_user_token"/>
                            <div colspan="2">
                                <small class="text-muted">
                                    User Access Token отримується у <a href="https://developers.facebook.com/tools/explorer/" target="_blank">Graph API Explorer</a>
                                    з permissions <b>pages_show_list</b> + <b>business_management</b>.
                                    Живе ~2 години. Після sync токен не зберігається.
                                    Безстрокові Page Tokens для кожної сторінки зберігаються у Facebook Pages.
                                </small>
                            </div>
                        </group>
                        <group string="Довідка">
                            <div colspan="2">
                                <small class="text-muted">
                                    Меню <b>SendPulse → Facebook Pages</b> — список усіх синхронізованих сторінок.<br/>
                                    Модуль автоматично резолвить Page за <code>page_id</code> з webhook — відповідає з потрібної сторінки.<br/>
                                    Legacy <code>fb_page_access_token</code> використовується як fallback якщо Page не знайдена.
                                </small>
                            </div>
                        </group>
                    </group>

                    <h2>LLM-класифікатор коментарів</h2>
                    <group>
                        <group string="Anthropic">
                            <field name="llm_classifier_enabled"/>
                            <field name="anthropic_api_key" password="True"
                                   placeholder="sk-ant-api03-..."/>
                            <field name="anthropic_api_key_is_set" invisible="1"/>
                            <div colspan="2">
                                <small class="text-success" invisible="not anthropic_api_key_is_set">✓ API key збережено</small>
                                <small class="text-warning" invisible="anthropic_api_key_is_set">⚠ API key не налаштовано</small>
                            </div>
                            <field name="llm_model"/>
                        </group>
                        <group string="Поведінка">
                            <field name="sp_comment_hide_spam_enabled"/>
                            <div colspan="2">
                                <small class="text-muted">
                                    Класифікує коментарі на 8 категорій (ціна/дати/вік/загальне/подяка/скарга/спам/інше).
                                    На подяку/спам не відповідаємо; спам приховуємо; скарга → Telegram оператору.
                                </small>
                            </div>
                        </group>
                    </group>

                    <h2>V2 Automation — Sprint 2</h2>
                    <group>
                        <group string="RAG FAQ auto-answer (F1)">
                            <field name="rag_auto_answer_enabled"/>
                            <field name="rag_auto_confidence_threshold"/>
                            <div colspan="2">
                                <small class="text-muted">
                                    Клієнт питає у DM → Claude шукає match у FAQ →
                                    якщо confidence ≥ threshold, автоматично відповідає.
                                    <br/>FAQ записи керуються у меню <b>SendPulse → FAQ Entries</b>.
                                    <br/>Потребує увімкнутий Anthropic API key.
                                </small>
                            </div>
                        </group>
                        <group string="Bot-wizard ідентифікації (F3)">
                            <field name="bot_identification_enabled"/>
                            <field name="bot_identification_max_attempts"/>
                            <div colspan="2">
                                <small class="text-muted">
                                    Новий контакт без партнера → бот запитує email →
                                    парсить з наступного inbound → створює
                                    <code>res.partner</code> автоматично.
                                    <br/>Працює для telegram, instagram, messenger, whatsapp, viber
                                    (сервіси без обмежень першого повідомлення).
                                    <br/>Після N невдалих спроб — передача оператору.
                                </small>
                            </div>
                        </group>
                    </group>

                    <h2>V2 Automation — Sprint 3</h2>
                    <group>
                        <group string="Drip campaigns (F2)">
                            <field name="drip_enabled"/>
                            <field name="drip_reminder_6h_enabled"/>
                            <field name="drip_reminder_6h_text"/>
                            <field name="drip_operator_alert_enabled"/>
                            <field name="drip_booking_3d_enabled"/>
                            <field name="drip_booking_3d_text"/>
                            <div colspan="2">
                                <small class="text-muted">
                                    Погодинний cron розсилає нагадування «зависли» клієнти +
                                    алерти менеджерам по довгих чергах. Opt-out — клієнт пише STOP /
                                    «не писати» / unsubscribe → встановлюється `drip_stop_requested=True`.
                                    <br/>Шле тільки якщо Meta 24h-вікно відкрите.
                                </small>
                            </div>
                        </group>
                    </group>

                    <h2>V2 Automation — Sprint 1</h2>
                    <group>
                        <group string="Auto-create lead (F4)">
                            <field name="auto_create_lead_enabled"/>
                            <field name="auto_create_lead_team_id"
                                   options="{'no_create': True, 'no_open': False}"/>
                            <div colspan="2">
                                <small class="text-muted">
                                    Коли клієнт відповідає у приват (funnel_stage → customer_replied) —
                                    автоматично створюється <b>crm.lead</b> з контактом, описом
                                    і лінком у Discuss. Якщо sales team не задано — береться дефолтна.
                                </small>
                            </div>
                        </group>
                        <group string="Auto-close inactive (F5)">
                            <field name="auto_close_inactive_enabled"/>
                            <field name="auto_close_inactive_days"/>
                            <field name="auto_close_goodbye_text"/>
                            <div colspan="2">
                                <small class="text-muted">
                                    Cron 1 раз/добу закриває розмови де клієнт не писав N днів.
                                    Розмови з активним opportunity у CRM — пропускаються.
                                    Goodbye — шлеться тільки якщо вікно Meta 24h ще відкрите.
                                </small>
                            </div>
                        </group>
                    </group>
                    <group>
                        <group string="Token refresh (F6)">
                            <field name="auto_refresh_tokens_enabled"/>
                            <field name="token_refresh_threshold_days"/>
                            <div colspan="2">
                                <small class="text-muted">
                                    Weekly cron: якщо Page Token помирає &lt; N днів →
                                    автоматично exchange на long-lived через Graph API.
                                    Потребує заповнених <code>fb_app_id</code> + <code>fb_app_secret</code>.
                                </small>
                            </div>
                        </group>
                        <group string="Archive + Reports (F7/F8)">
                            <field name="auto_archive_comments_enabled"/>
                            <field name="auto_archive_comments_days"/>
                            <field name="weekly_report_enabled"/>
                            <div colspan="2">
                                <small class="text-muted">
                                    <b>F7:</b> soft-archive (active=False) старих закритих comment-записів.<br/>
                                    <b>F8:</b> понеділок 09:00 UTC → зводка у Telegram-групу.
                                    Потребує увімкнутих Telegram-алертів.
                                </small>
                            </div>
                        </group>
                    </group>

                    <h2>Telegram-алерти менеджерам</h2>
                    <group>
                        <group string="Bot">
                            <field name="telegram_alerts_enabled"/>
                            <field name="telegram_bot_token" password="True"
                                   placeholder="7123456789:AAEr..."/>
                            <field name="telegram_bot_token_is_set" invisible="1"/>
                            <div colspan="2">
                                <small class="text-success" invisible="not telegram_bot_token_is_set">✓ Bot token збережено</small>
                                <small class="text-warning" invisible="telegram_bot_token_is_set">⚠ Token не налаштовано</small>
                            </div>
                            <field name="telegram_chat_id"
                                   placeholder="-1001234567890"/>
                        </group>
                        <group string="Події">
                            <div colspan="2">
                                <small class="text-muted">
                                    Що надсилається у групу:<br/>
                                    🚨 Скарги під постами (LLM-класифікатор)<br/>
                                    🚫 Прихований спам (silent)<br/>
                                    ⏳ Закриття 24h-вікна за 2h (silent)<br/>
                                    ⚠️ FB Page Token недійсний / термін ≤ 7д
                                </small>
                            </div>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Server Action: Sync Discuss channels -->
    <record id="action_sync_discuss_channels" model="ir.actions.server">
        <field name="name">Sync Discuss каналів</field>
        <field name="model_id" ref="model_sendpulse_connect"/>
        <field name="binding_model_id" ref="model_sendpulse_connect"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">records.action_sync_discuss_channels()</field>
        <field name="groups_id" eval="[(4, ref('odoo_chatwoot_connector.group_sendpulse_admin'))]"/>
    </record>

    <!-- Actions -->
    <record id="action_sendpulse_connect_all" model="ir.actions.act_window">
        <field name="name">Всі розмови</field>
        <field name="res_model">sendpulse.connect</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_sendpulse_connect_search"/>
        <field name="domain">[('stage', '!=', 'close')]</field>
        <field name="context">{}</field>
    </record>

    <record id="action_sendpulse_connect_unidentified" model="ir.actions.act_window">
        <field name="name">Нові чати</field>
        <field name="res_model">sendpulse.connect</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('partner_id','=',False),('stage','!=','close')]</field>
    </record>

    <record id="action_sendpulse_webhook_data" model="ir.actions.act_window">
        <field name="name">Webhook Дані</field>
        <field name="res_model">sendpulse.webhook.data</field>
        <field name="view_mode">list</field>
    </record>

    <record id="action_sendpulse_config" model="ir.actions.act_window">
        <field name="name">Налаштування SendPulse</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_sendpulse_config_form"/>
        <field name="target">new</field>
    </record>

    <!-- Menu -->
    <menuitem id="menu_sendpulse_root"
              name="SendPulse"
              sequence="90"
              web_icon="odoo_chatwoot_connector,static/description/icon.png"
              groups="odoo_chatwoot_connector.group_sendpulse_officer"/>

    <menuitem id="menu_sendpulse_all"
              name="Всі розмови"
              parent="menu_sendpulse_root"
              action="action_sendpulse_connect_all"
              sequence="10"/>

    <menuitem id="menu_sendpulse_unidentified"
              name="Нові чати"
              parent="menu_sendpulse_root"
              action="action_sendpulse_connect_unidentified"
              sequence="20"/>

    <menuitem id="menu_sendpulse_config"
              name="Налаштування"
              parent="menu_sendpulse_root"
              action="action_sendpulse_config"
